{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PrintFlow",
  "version": "0.1.2",
  "identifier": "com.printflow.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "node scripts/tauri-dev.mjs",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PrintFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "dragDropEnabled": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../printflow-data/cache/finish.json": "printflow-data/cache/finish.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRDJGNjExRUZFMzNDQ0UKUldUT1BPUHZFZmJTVWZTaGw5SzRXeVc2UW4yRWIwM0VRTDhEUjY3eHU2Y3Q1b2p1UUQxUkRsU3IK",
      "endpoints": [
        "https://github.com/BaiLiAiChiBiJiLin/ProductAPP/releases/latest/download/latest.json"
      ]
    }
  }
}
